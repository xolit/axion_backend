<section>
  <h2>Add a New Movie</h2>
  <form
    action="/admin/movie/add?accessToken=<%= encodeURIComponent(accessToken) %>&adminPass=<%= encodeURIComponent(adminPass) %>"
    method="post"
    id="addMovieForm"
  >
    <input type="hidden" name="accessToken" value="<%= accessToken %>" />
    <input type="hidden" name="adminPass" value="<%= adminPass %>" />

    <label for="title">Title</label>
    <input
      id="title"
      name="title"
      type="text"
      placeholder="Enter movie title ex- Avengers"
      required
    />

    <label for="release">Release</label>
    <input
      id="release"
      name="release"
      type="text"
      placeholder="Enter release date ex- 2026"
    />

    <label for="SubGenere">SubGenre</label>
    <input
      id="SubGenere"
      name="SubGenere"
      type="text"
      placeholder="Movie, TvShow"
    />

    <label for="Wood">Wood</label>
    <input
      id="Wood"
      name="Wood"
      type="text"
      placeholder="Bollywood, Hollywood"
    />

    <label for="MultimoviesDomain">Multimovies domain? ex- .study</label>
    <input type="text" id="MultimoviesDomain" name="MultimoviesDomain" />

    <label for="CineHDDomain">CineHD domain? ex- .app</label>
    <input type="text" id="CineHDDomain" name="CineHDDomain" />

    <label for="CinevaroDomain">Cinevaro domain? ex- .app</label>
    <input type="text" id="CinevaroDomain" name="CinevaroDomain" />

    <label for="FlixeoDomain">Flixeo domain? ex- .tv</label>
    <input type="text" id="FlixeoDomain" name="FlixeoDomain" />

    <label for="Source">Sources (paste URLs or use key=value format)</label>
    <textarea
      id="Source"
      name="Source"
      placeholder="https://multimovies.com/movie/123&#10;https://onemovies.io/watch/456&#10;or&#10;Multimovies=https://multimovies.com/movie/123&#10;OneMovies=https://onemovies.io/watch/456"
    ></textarea>

    <button type="submit">Add Movie</button>
  </form>
</section>

<script>
  const fields = [
    "MultimoviesDomain",
    "CineHDDomain",
    "CinevaroDomain",
    "FlixeoDomain",
    "SubGenere",
    "Wood",
  ];

  // Restore saved values
  fields.forEach((field) => {
    const savedValue = localStorage.getItem(field);
    if (savedValue) {
      document.getElementById(field).value = savedValue;
    }
  });

  // Save values on form submit
  document
    .getElementById("addMovieForm")
    .addEventListener("submit", function () {
      fields.forEach((field) => {
        localStorage.setItem(
          field,
          document.getElementById(field).value.trim(),
        );
      });
    });
</script>
